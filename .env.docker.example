# Minimal environment for Docker Compose (copy to .env.docker and fill in real values)
DATABASE_URL=sqlite:///./data/veritas.db
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_ANALYZER_MODEL=mistral:latest
OLLAMA_MODEL=mistral:latest
VERITAS_DISABLE_OLLAMA=0
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173

# External providers
NEWSAPI_KEY=YOUR_NEWSAPI_KEY
SERPAPI_KEY=YOUR_SERPAPI_KEY
# Tavily is the PRIMARY retrieval provider (chain: Tavily -> SerpAPI -> NewsAPI -> local)
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=10
TAVILY_INCLUDE_RAW_CONTENT=1
VERITAS_USE_ADVANCED_RAG=0
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Groq is the primary cloud reasoning provider (works inside containers).
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_DEFENDER_MODEL=llama-3.1-8b-instant
GROQ_JUDGE_MODEL=llama-3.3-70b-versatile

# LLM agents on: uses Groq -> Gemini -> Ollama, with deterministic stance
# fallback if all providers fail.
VERITAS_ENABLE_LLM_AGENTS=1
VERITAS_ENABLE_CLAIM_ANALYZER_LLM=0
VERITAS_ENABLE_EVIDENCE_CLASSIFIER_LLM=0
GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=600
GROQ_RATE_LIMIT_COOLDOWN_SECONDS=120

# Ollama bootstrap
OLLAMA_AUTO_PULL_MODELS=1
OLLAMA_BOOT_MODELS=mistral:latest
OLLAMA_BLOCK_ON_MODEL_PULL=0
